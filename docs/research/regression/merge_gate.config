// Merge gate (#41): overrides for the v2 run on PALM14E, on top of PALM14E's nextflow.config.
// Queue and per-process resources (MB, minutes) come from the environment, so the mocks
// (base.config defaults, short queue) and the full run (mock peaks + 50 %) share one file.
def env = System.getenv()
def mb = { String name, int dflt -> (env[name] ?: "${dflt}") as int }

process {
    queue = env.GATE_QUEUE ?: 'short'
    withName: SPLIT_BAM {
        cpus   = mb('SPLIT_CPUS', 8)
        memory = { "${mb('SPLIT_MB', 20480) * task.attempt} MB" }
        time   = { "${mb('SPLIT_MIN', 120) * task.attempt} min" }
    }
    withName: CONSENSUS {
        memory = { "${mb('CONS_MB', 3072) * task.attempt} MB" }
        time   = { "${mb('CONS_MIN', 20) * task.attempt} min" }
    }
    withName: COLLAPSE {
        memory = { "${mb('COLL_MB', 1024) * task.attempt} MB" }
        time   = { "${mb('COLL_MIN', 120) * task.attempt} min" }
    }
    withName: GENOTYPING {
        memory = { "${mb('GENO_MB', 5120) * task.attempt} MB" }
        time   = { "${mb('GENO_MIN', 120) * task.attempt} min" }
    }
}

executor {
    queueSize = 200
}

trace {
    enabled   = true
    file      = "trace.txt"
    overwrite = true
    fields    = 'task_id,hash,name,status,exit,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}
