includeConfig "config/base.config"

// Parameters

params {

    input                   = ""
    outdir                  = "results"

    minimap2_mindex         = null
    minimap2_input_genome   = null
    bedfile                 = null

    // UMI grouping
    min_mapping_quality     = 20

    // Consensus
    min_reads               = 2
    min_fraction            = 0.6
    snv_min_base_quality    = 20

    // Genotyping
    error_floor             = 0.0001

    // BLAZE
    blaze_expect_cells      = 5000
    blaze_edit_distance     = 1

    // Pinned image, built by .github/workflows/docker.yml from docker/
    container               = 'ghcr.io/dimadatascience/nanogen@sha256:764368d67cdc01c3e40a83157154b97096b7b6ffb2ec740c4c8a4a408720f9ed'

    // Boilerplate options
    publish_dir_mode             = 'copy'
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    hook_url                     = null
    help                         = false
    version                      = false

    // Schema validation default options
    validate_params              = true
    show_hidden_params           = false
    schema_ignore_params         = ''

}

// Every process runs in the same pinned image
process.container = params.container


// Manifest
manifest {
  name = 'NanoGen'
  author = 'Andrea Cossa, Yinxiu Zhan'
  homePage = 'https://github.com/dimadatascience/NanoGen.git'
  description = 'Preprocessing pipeline target-enriched long-reads.'
  mainScript = 'main.nf'
  nextflowVersion = '>=20.01.0'
  version = '0.1'
}

// Profiles
profiles {
    debug { process.beforeScript = 'echo $HOSTNAME' }
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        charliecloud.enabled   = false
        podman.enabled         = false
        shifter.enabled        = false
        singularity.enabled    = false
        
    }
    singularity {
        singularity.autoMounts = true
        singularity.enabled    = true
        charliecloud.enabled   = false
        docker.enabled         = false
        podman.enabled         = false
        shifter.enabled        = false
    }
}

 
// Tracing
trace {
    enabled = true
    file = "trace.txt"
    overwrite = true
}

// Tower
tower {
  enabled = false
}

