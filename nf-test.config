// nf-test configuration. Versions are pinned here and in .github/workflows/ci.yml
// (NFT_VER, NXF_VER); tests/nextflow.config enforces the Nextflow version.

config {
    testsDir   "tests"
    workDir    ".nf-test"
    configFile "tests/nextflow.config"

    requires (
        "nf-test": "0.9.2"
    )
}
