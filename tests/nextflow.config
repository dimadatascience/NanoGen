// Test-only overrides, loaded by nf-test on top of nextflow.config.

// Tests run on the Nextflow version CI pins (NXF_VER in .github/workflows/ci.yml)
manifest.nextflowVersion = '!25.04.4'

// Fit every process on a CI runner (base.config asks for up to 30 CPUs)
process {
    resourceLimits = [cpus: 2, memory: 6.GB, time: 1.h]
    errorStrategy  = 'terminate'
}
